// The site, REST and MCP on Workers via OpenNext. Background jobs are apps/worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polyradar-web",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "polyradar.wayai.cc", "custom_domain": true }],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "polyradar-web" }],
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "REPLACE_WITH_HYPERDRIVE_ID", "localConnectionString": "postgres://way:local@localhost:54317/polyradar" }
  ]
}
